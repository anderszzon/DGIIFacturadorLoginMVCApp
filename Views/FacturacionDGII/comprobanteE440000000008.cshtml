            </div>
            <div class="form-group col-md-3">
                <label>MontoTotal</label>
                <input asp-for="ECF.Encabezado.Totales.MontoTotal" id="totalGeneral" class="form-control" />
            </div>
            <div class="form-group col-md-3">
                <label>MontoPeriodo</label>
                <input asp-for="ECF.Encabezado.Totales.MontoPeriodo" id="totalGeneral" class="form-control" />
            </div>
            <div class="form-group col-md-3">
                <label>Valor Pagar</label>
                <input asp-for="ECF.Encabezado.Totales.ValorPagar" id="totalGeneral" class="form-control" />
