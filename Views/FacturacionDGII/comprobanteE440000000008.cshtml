                            <div class="col-md-3">
                                <label>Monto de Pago</label>
                                <input asp-for="ECF.Encabezado.IdDoc.TablaFormasPago.FormaDePago[i].MontoPago" class="form-control" />
                            </div>
                        </div>
                    }
