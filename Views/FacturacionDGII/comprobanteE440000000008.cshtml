@model FacturaDGIIModel12

<form asp-action="comprobanteE440000000008" method="post" id="facturaForm">
    <!-- Sección de datos generales -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h3>Datos Generales</h3>
        </div>
        <div class="card-body">
            <div class="form-group">
                <label asp-for="ECF.Encabezado.Version"></label>
                <input asp-for="ECF.Encabezado.Version" class="form-control" value="1.0" readonly />
            </div>
        </div>
    </div>

    <!-- Sección de identificación del documento -->
