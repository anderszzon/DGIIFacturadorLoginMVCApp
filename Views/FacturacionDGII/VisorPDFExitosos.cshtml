@model IEnumerable<DGIIFacturadorLoginMVCApp.Models.FacturasDGII>

@{
    ViewData["Title"] = "Visor PDF Exitosos";
    var codigos = ViewBag.CodigosSeguridad as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0">Comprobantes Emitidos - Generar PDF</h4>
        <input type="text" id="buscarFactura" class="form-control form-control-sm w-25" placeholder="Buscar e-NCF o Cliente..." />
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle" id="tablaExitosos">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Factura Interna</th>
                        <th>e-NCF</th>
                        <th>Fecha Emisión</th>
                        <th>RNC Comprador</th>
                        <th>Comprador</th>
                        <th class="text-end">Monto Total</th>
                        <th class="text-center">PDF</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        string codSeguridad = codigos.ContainsKey(item.Id) ? codigos[item.Id] : "";

                        <tr>
                            <td>@item.Id</td>
                            <td class="fw-bold">@item.NumeroFacturaInterna</td>
                            <td><span class="badge bg-success">@item.ENCF</span></td>
                            <td>@item.FechaEmision</td>
                            <td>@item.RNCComprador</td>
                            <td>@item.RazonSocialComprador</td>
                            <td class="text-end fw-bold">@item.MontoTotal.ToString("N2")</td>
                            <td class="text-center">
                                <a asp-controller="FacturacionDGII"
                                   asp-action="GenerarPDF"
                                   asp-route-id="@item.Id"
                                   asp-route-codigoSeguridad="@codSeguridad"
                                   target="_blank"
                                   class="btn btn-danger btn-sm">
                                    Descargar / Ver PDF
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('buscarFactura')?.addEventListener('keyup', function () {
            const filtro = this.value.toLowerCase();
            document.querySelectorAll('#tablaExitosos tbody tr').forEach(fila => {
                fila.style.display = fila.textContent.toLowerCase().includes(filtro) ? '' : 'none';
            });
        });
    </script>
}