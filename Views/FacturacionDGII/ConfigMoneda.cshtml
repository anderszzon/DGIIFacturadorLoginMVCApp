@model IEnumerable<Monedas>

@{
    ViewData["Title"] = "Monedas Registradas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Catálogo de Monedas</h2>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<table class="table table-striped table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th>Tipo Moneda</th>
            <th>Tasa / Tipo Cambio</th>
            <th class="text-center">Estado</th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var moneda in Model)
        {
            <!-- 1. Uso de == true para el operador ternario -->
            <tr class="@(moneda.Activo == true ? "table-success fw-bold" : "")">
                <form asp-controller="FacturacionDGII" asp-action="SeleccionarMoneda" method="post">
                    <input type="hidden" name="idMoneda" value="@moneda.IdMoneda" />

                <td>@moneda.Moneda</td>
                <td>
                    <input type="number"
                           step="0.0001"
                           name="tipoCambio"
                           value="@(moneda.TipoCambio.HasValue? moneda.TipoCambio.Value.ToString("0.0000", System.Globalization.CultureInfo.InvariantCulture) : "1.0000")"
                           class="form-control form-control-sm"
                           style="width: 130px;"
                           required />
                </td>
                <td class="text-center">
                    <!-- 2. Uso de == true en el if -->
                    @if (moneda.Activo == true)
                    {
                        <span class="badge bg-success">ACTIVA</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">INACTIVA</span>
                    }
                </td>
                <td class="text-center">
                    <!-- 3. Uso de == true en las acciones -->
                    @if (moneda.Activo == true)
                    {
                        <button type="submit" class="btn btn-sm btn-success">
                            Actualizar Moneda 
                        </button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-sm btn-outline-primary">
                            Seleccionar Moneda
                        </button>
                    }
                </td>
                </form>
            </tr>
        }
    </tbody>
</table>