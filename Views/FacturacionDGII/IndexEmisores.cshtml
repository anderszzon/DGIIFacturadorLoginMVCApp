@model IEnumerable<EmisorInfo>

@{
    ViewData["Title"] = "Emisores Registrados";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Emisores Registrados</h2>
    <a asp-action="RegistrarEmisor" class="btn btn-primary">Registrar Nuevo Emisor</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>RNC</th>
            <th>Razón Social</th>
            <th>Nombre Comercial</th>
            <th>Dirrecion Emisor</th>
            <th>Correo</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var emisor in Model)
        {
            <tr>
                <td>@emisor.RNCEmisor</td>
                <td>@emisor.RazonSocialEmisor</td>
                <td>@emisor.NombreComercial</td>
                <td>@emisor.DireccionEmisor</td>
                <td>@emisor.CorreoEmisor</td>
                <td>
                    <a asp-controller="FacturacionDGII"
                       asp-action="ComprobanteE31"
                       asp-route-emisorId="@emisor.IdEmisor"
                       class="btn btn-sm btn-outline-success">
                        Seleccionar Emisor
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>