@using DGIIFacturadorLoginMVCApp.Helpers
@model FacturaDGIIModel2

@{
    string monedaActiva = ViewBag.TipoMonedaActiva?.ToString()?.Trim().ToUpper();
}

<form asp-action="comprobanteE31" method="post" id="facturaForm">
    <!-- Sección de datos generales -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h3>Datos Generales</h3>
        </div>
        <div class="card-body">
            <div class="form-group">
                <label asp-for="ECF.Encabezado.Version"></label>
                <input asp-for="ECF.Encabezado.Version" class="form-control" value="1.0" readonly />
            </div>
        </div>
    </div>

    <!-- Sección de identificación del documento -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h3>Identificación del Documento</h3>
        </div>
        <div class="card-body row">
            <div class="form-group col-md-3">
                <label asp-for="ECF.Encabezado.IdDoc.TipoeCF"></label>
                <input asp-for="ECF.Encabezado.IdDoc.TipoeCF" class="form-control" value="31" readonly />
            </div>
            <div class="form-group col-md-3">
                <label asp-for="ECF.Encabezado.IdDoc.eNCF"></label>
                <input asp-for="ECF.Encabezado.IdDoc.eNCF" class="form-control" readonly />
            </div>
            <div class="form-group col-md-3">
                <label asp-for="ECF.Encabezado.IdDoc.FechaVencimientoSecuencia"></label>
                <input asp-for="ECF.Encabezado.IdDoc.FechaVencimientoSecuencia" class="form-control" />
            </div>
            <div class="form-group col-md-3">
                <label asp-for="ECF.Encabezado.IdDoc.IndicadorMontoGravado"></label>
                <select asp-for="ECF.Encabezado.IdDoc.IndicadorMontoGravado" class="form-control">
                    <option value="0">No</option>
                    <option value="1">Sí</option>
                </select>
            </div>
            <div class="form-group col-md-3">
                <label asp-for="ECF.Encabezado.IdDoc.TipoIngresos"></label>
                <select asp-for="ECF.Encabezado.IdDoc.TipoIngresos"
                        asp-items="EnumHelper.ObtenerTipoIngresos()"
                        class="form-control">
                </select>
            </div>
            <div class="form-group col-md-3">
                <label asp-for="ECF.Encabezado.IdDoc.TipoPago"></label>
                <select asp-for="ECF.Encabezado.IdDoc.TipoPago" class="form-control">
                    <option value="1">Contado</option>
                    <option value="2">Crédito</option>
                </select>
            </div>

            <div class="form-group col-md-3">
                <label asp-for="ECF.Encabezado.Emisor.NumeroFacturaInterna"></label>
                <input asp-for="ECF.Encabezado.Emisor.NumeroFacturaInterna" class="form-control" readonly />
            </div>
            <div class="form-group col-md-3">
                <label asp-for="ECF.Encabezado.Emisor.FechaEmision"></label>
                <input asp-for="ECF.Encabezado.Emisor.FechaEmision" class="form-control" />
            </div>

        </div>
    </div>

    <!-- Sección de datos del emisor -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h3>Datos del Emisor</h3>
        </div>
        <div class="card-body row">
            <div class="form-group col-md-4">
                <label asp-for="ECF.Encabezado.Emisor.RNCEmisor"></label>
                <input asp-for="ECF.Encabezado.Emisor.RNCEmisor" class="form-control" readonly />
            </div>
            <div class="form-group col-md-4">
                <label asp-for="ECF.Encabezado.Emisor.RazonSocialEmisor"></label>
                <input asp-for="ECF.Encabezado.Emisor.RazonSocialEmisor" class="form-control" readonly />
            </div>
            <div class="form-group col-md-4">
                <label asp-for="ECF.Encabezado.Emisor.NombreComercial"></label>
                <input asp-for="ECF.Encabezado.Emisor.NombreComercial" class="form-control" readonly />
            </div>
            <div class="form-group col-md-6">
                <label asp-for="ECF.Encabezado.Emisor.DireccionEmisor"></label>
                <input asp-for="ECF.Encabezado.Emisor.DireccionEmisor" class="form-control" readonly />
            </div>
            <div class="form-group col-md-4">
                <label asp-for="ECF.Encabezado.Emisor.CorreoEmisor"></label>
                <input asp-for="ECF.Encabezado.Emisor.CorreoEmisor" type="email" class="form-control" readonly />
            </div>
            @*
            <div class="form-group col-md-3">
                <label asp-for="ECF.Encabezado.Emisor.NumeroFacturaInterna"></label>
                <input asp-for="ECF.Encabezado.Emisor.NumeroFacturaInterna" class="form-control" readonly />
            </div>
            <div class="form-group col-md-3">
                <label asp-for="ECF.Encabezado.Emisor.FechaEmision"></label>
                <input asp-for="ECF.Encabezado.Emisor.FechaEmision" class="form-control" readonly />
            </div> 
            *@
        </div>
    </div>

    <!-- Sección de datos del comprador -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h3>Datos del Comprador</h3>
        </div>
        <div class="card-body row">
            <div class="form-group col-md-4">
                <label asp-for="ECF.Encabezado.Comprador.RNCComprador"></label>
                <input asp-for="ECF.Encabezado.Comprador.RNCComprador" class="form-control" required />
            </div>
            <div class="form-group col-md-4">
                <label asp-for="ECF.Encabezado.Comprador.RazonSocialComprador"></label>
                <input asp-for="ECF.Encabezado.Comprador.RazonSocialComprador" class="form-control" required />
            </div>
            <div class="form-group col-md-6">
                <label asp-for="ECF.Encabezado.Comprador.DireccionComprador"></label>
                <input asp-for="ECF.Encabezado.Comprador.DireccionComprador" class="form-control" required />
            </div>
        </div>
    </div>

    <!-- Sección de totales oficiales (Base: DOP) -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h3>Totales</h3>
        </div>
        <div class="card-body row">
            <div class="form-group col-md-3">
                <label>MontoGravadoTotal</label>
                <input asp-for="ECF.Encabezado.Totales.MontoGravadoTotal" id="montoGravadoTotal" class="form-control" readonly />
            </div>
            <div class="form-group col-md-3">
                <label>MontoGravadoI1</label>
                <input asp-for="ECF.Encabezado.Totales.MontoGravadoI1" id="montoGravadoI1" class="form-control" readonly />
            </div>
            <div class="form-group col-md-3">
                <label>ITBIS1</label>
                <input asp-for="ECF.Encabezado.Totales.ITBIS1" id="ITBIS1" class="form-control" readonly />
            </div>
            <div class="form-group col-md-3">
                <label>TotalITBIS</label>
                <input asp-for="ECF.Encabezado.Totales.TotalITBIS" id="totalITBIS" class="form-control" readonly />
            </div>
            <div class="form-group col-md-3">
                <label>TotalITBIS1</label>
                <input asp-for="ECF.Encabezado.Totales.TotalITBIS1" id="totalITBIS1" class="form-control" readonly />
            </div>
            <div class="form-group col-md-3">
                <label>MontoTotal</label>
                <input asp-for="ECF.Encabezado.Totales.MontoTotal" id="totalGeneral" class="form-control" readonly />
            </div>
            <div class="form-group col-md-3">
                <label>MontoPeriodo</label>
                <input asp-for="ECF.Encabezado.Totales.MontoPeriodo" id="MontoPeriodo" class="form-control" readonly />
            </div>
            <div class="form-group col-md-3">
                <label>ValorPagar</label>
                <input asp-for="ECF.Encabezado.Totales.ValorPagar" id="ValorPagar" class="form-control" readonly />
            </div>
        </div>
    </div>

    @if (monedaActiva != "DOP")
    {
        <div class="card mb-4 border-info">
            <div class="card-header bg-primary text-white">
                <h3>OtraMoneda (@monedaActiva)</h3>
            </div>
            <div class="card-body row">
                <div class="form-group col-md-3">
                    <label asp-for="ECF.Encabezado.OtraMoneda.TipoMoneda">TipoMoneda</label>
                    <input asp-for="ECF.Encabezado.OtraMoneda.TipoMoneda"
                           id="otraMonedaTipo"
                           class="form-control"
                           value="@monedaActiva"
                           readonly />
                </div>
                <div class="form-group col-md-3">
                    <label asp-for="ECF.Encabezado.OtraMoneda.TipoCambio">TipoCambio</label>
                    <input asp-for="ECF.Encabezado.OtraMoneda.TipoCambio"
                           id="otraMonedaCambio"
                           class="form-control"
                           value="@(ViewBag.TipoCambioActivo != null ? Convert.ToDecimal(ViewBag.TipoCambioActivo).ToString("0.0000", System.Globalization.CultureInfo.InvariantCulture) : "1.0000")"
                           readonly />
                </div>
                <div class="form-group col-md-3">
                    <label asp-for="ECF.Encabezado.OtraMoneda.MontoGravadoTotalOtraMoneda">MontoGravadoTotalOtraMoneda</label>
                    <input asp-for="ECF.Encabezado.OtraMoneda.MontoGravadoTotalOtraMoneda"
                           id="otraMonedaGravadoTotal"
                           class="form-control"
                           value="0.00"
                           readonly />
                </div>
                <div class="form-group col-md-3">
                    <label asp-for="ECF.Encabezado.OtraMoneda.MontoGravado1OtraMoneda">MontoGravado1OtraMoneda</label>
                    <input asp-for="ECF.Encabezado.OtraMoneda.MontoGravado1OtraMoneda"
                           id="otraMonedaGravado1"
                           class="form-control"
                           value="0.00"
                           readonly />
                </div>
                <div class="form-group col-md-3">
                    <label asp-for="ECF.Encabezado.OtraMoneda.MontoExentoOtraMoneda">MontoExentoOtraMoneda</label>
                    <input asp-for="ECF.Encabezado.OtraMoneda.MontoExentoOtraMoneda"
                           id="otraMonedaExento"
                           class="form-control"
                           value="0.00"
                           readonly />
                </div>
                <div class="form-group col-md-3">
                    <label asp-for="ECF.Encabezado.OtraMoneda.TotalITBISOtraMoneda">TotalITBISOtraMoneda</label>
                    <input asp-for="ECF.Encabezado.OtraMoneda.TotalITBISOtraMoneda"
                           id="otraMonedaTotalITBIS"
                           class="form-control"
                           value="0.00"
                           readonly />
                </div>
                <div class="form-group col-md-3">
                    <label asp-for="ECF.Encabezado.OtraMoneda.TotalITBIS1OtraMoneda">TotalITBIS1OtraMoneda</label>
                    <input asp-for="ECF.Encabezado.OtraMoneda.TotalITBIS1OtraMoneda"
                           id="otraMonedaTotalITBIS1"
                           class="form-control"
                           value="0.00"
                           readonly />
                </div>
                <div class="form-group col-md-3">
                    <label asp-for="ECF.Encabezado.OtraMoneda.MontoTotalOtraMoneda">MontoTotalOtraMoneda</label>
                    <input asp-for="ECF.Encabezado.OtraMoneda.MontoTotalOtraMoneda"
                           id="otraMonedaTotal"
                           class="form-control"
                           value="0.00"
                           readonly />
                </div>
            </div>
        </div>
    }

    <!-- Sección de ítems (dinámica) -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h3>Detalle de Items</h3>
            <button type="button" id="addItemBtn" class="btn btn-success">Agregar Item</button>
        </div>
        <div class="card-body" id="itemsContainer">
            @for (int i = 0; i < Model.ECF.DetallesItems.Item.Count; i++)
            {
                <div class="item-row card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5>Item @(i + 1)</h5>
                        <button type="button" class="btn btn-danger btn-sm remove-item">Eliminar</button>
                    </div>
                    <div class="card-body row">
                        <input type="hidden" asp-for="ECF.DetallesItems.Item[i].NumeroLinea" value="@(i + 1)" class="item-numero-linea" />
@* 
                        @if (monedaActiva != "DOP")
                        {
                            <input type="hidden" asp-for="ECF.DetallesItems.Item[i].OtraMonedaDetalle.PrecioOtraMoneda" class="item-precio-otra" value="0.00" />
                            <input type="hidden" asp-for="ECF.DetallesItems.Item[i].OtraMonedaDetalle.MontoItemOtraMoneda" class="item-monto-otra" value="0.00" />
                        } *@

                        <div class="form-group col-md-3">
                            <label>Código del Ítem</label>
                            <input asp-for="ECF.DetallesItems.Item[i].TablaCodigosItem.CodigosItem[0].CodigoItem" class="form-control item-codigo" value="@($"MTP{(i + 1):D3}")" readonly />
                        </div>

                        <div class="form-group col-md-3">
                            <label>Nombre del Item</label>
                            <input asp-for="ECF.DetallesItems.Item[i].NombreItem" class="form-control item-name" required />
                        </div>
                        <div class="form-group col-md-2">
                            <label>Tipo</label>
                            <select asp-for="ECF.DetallesItems.Item[i].IndicadorBienoServicio" class="form-control">
                                <option value="1">Bien</option>
                                <option value="2">Servicio</option>
                            </select>
                        </div>
                        <div class="form-group col-md-1 border border-danger p-2 rounded bg-light">
                            <label class="text-danger fw-bold">Ind. Fact.</label>
                            <input asp-for="ECF.DetallesItems.Item[i].IndicadorFacturacion" class="form-control border-danger" value="1" readonly />
                        </div>
                        <div class="form-group col-md-2">
                            <label>Cantidad</label>
                            <input asp-for="ECF.DetallesItems.Item[i].CantidadItem" type="number" step="0.01" min="0.01" class="form-control item-quantity" required />
                        </div>
                        <div class="form-group col-md-2">
                            <label>Unidad</label>
                            <input asp-for="ECF.DetallesItems.Item[i].UnidadMedida" type="number" step="0.01" class="form-control" readonly />
                        </div>
                        <div class="form-group col-md-2">
                            <label>Precio Unitario</label>
                            <input asp-for="ECF.DetallesItems.Item[i].PrecioUnitarioItem" type="number" step="0.01" min="0.01" class="form-control item-price" required />
                        </div>
                        <div class="form-group col-md-2">
                            <label>Total</label>
                            <input asp-for="ECF.DetallesItems.Item[i].MontoItem" type="number" step="0.01" class="form-control item-total" readonly />
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Sección de fecha y hora de firma -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h3>Fecha y Hora de Firma</h3>
        </div>
        <div class="card-body">
            <div class="form-group">
                <label asp-for="ECF.FechaHoraFirma"></label>
                <input asp-for="ECF.FechaHoraFirma" class="form-control" readonly />
            </div>
        </div>
    </div>

    <div class="text-center">
        <button type="submit" class="btn btn-primary btn-lg">Registrar Factura</button>
    </div>
</form>

@section Scripts {
    <script>
        function generarCodigoItem(numero) {
            return 'MTP' + String(numero).padStart(3, '0');
        }

        function setVal(id, valor) {
            const el = document.getElementById(id);
            if (el) el.value = valor;
        }

        function obtenerTasaCambio() {
            const inputTasa = document.getElementById('otraMonedaCambio');
            if (!inputTasa) return 1;
            const tasa = parseFloat(inputTasa.value.replace(',', '.')) || 1;
            return tasa > 0 ? tasa : 1;
        }

        function calcularTotalesE31() {
            let subtotalMonedaSeleccionada = 0;
            const tasaITBIS18 = 0.18;
            const tasaCambio = obtenerTasaCambio();

            // 1. Calcular líneas en la moneda activa (USD si != DOP, o DOP)
            const filas = document.querySelectorAll('.item-row');
            filas.forEach(fila => {
                const cantInput = fila.querySelector('.item-quantity');
                const precioInput = fila.querySelector('.item-price');
                const totalInput = fila.querySelector('.item-total');

                const cantidad = parseFloat(cantInput ? cantInput.value : 0) || 0;
                const precio = parseFloat(precioInput ? precioInput.value : 0) || 0;

                const montoLinea = cantidad * precio;
                if (totalInput) {
                    totalInput.value = montoLinea.toFixed(2);
                }

                // Llenar OtraMonedaDetalle de la línea (si existe)
                const precioOtroInput = fila.querySelector('.item-precio-otra');
                const montoOtroInput = fila.querySelector('.item-monto-otra');
                if (precioOtroInput) precioOtroInput.value = precio.toFixed(2);
                if (montoOtroInput) montoOtroInput.value = montoLinea.toFixed(2);

                subtotalMonedaSeleccionada += montoLinea;
            });

            const itbisMonedaSeleccionada = subtotalMonedaSeleccionada * tasaITBIS18;
            const totalMonedaSeleccionada = subtotalMonedaSeleccionada + itbisMonedaSeleccionada;

            // 2. Llenar TODOS los campos de OtraMoneda (Encabezado)
            const inputOtraMonedaTotal = document.getElementById('otraMonedaTotal');
            if (inputOtraMonedaTotal) {
                setVal('otraMonedaGravadoTotal', subtotalMonedaSeleccionada.toFixed(2));
                setVal('otraMonedaGravado1', subtotalMonedaSeleccionada.toFixed(2));
                setVal('otraMonedaExento', "0.00");
                setVal('otraMonedaTotalITBIS', itbisMonedaSeleccionada.toFixed(2));
                setVal('otraMonedaTotalITBIS1', itbisMonedaSeleccionada.toFixed(2));
                setVal('otraMonedaTotal', totalMonedaSeleccionada.toFixed(2));
            }

            // 3. Totales Oficiales (Siempre en DOP = MonedaSeleccionada * TipoCambio)
            const montoGravadoDOP = subtotalMonedaSeleccionada * tasaCambio;
            const totalITBISDOP = itbisMonedaSeleccionada * tasaCambio;
            const montoTotalDOP = totalMonedaSeleccionada * tasaCambio;

            setVal('montoGravadoTotal', montoGravadoDOP.toFixed(2));
            setVal('montoGravadoI1', montoGravadoDOP.toFixed(2));
            setVal('ITBIS1', "18");
            setVal('totalITBIS', totalITBISDOP.toFixed(2));
            setVal('totalITBIS1', totalITBISDOP.toFixed(2));
            setVal('totalGeneral', montoTotalDOP.toFixed(2));
            setVal('MontoPeriodo', montoTotalDOP.toFixed(2));
            setVal('ValorPagar', montoTotalDOP.toFixed(2));
        }

        document.addEventListener('DOMContentLoaded', function () {
            const container = document.getElementById('itemsContainer');
            const addBtn = document.getElementById('addItemBtn');
            const form = document.getElementById('facturaForm');

            calcularTotalesE31();

            // Agregar nuevo Ítem dinámicamente
            addBtn.addEventListener('click', function () {
                const currentIndex = container.querySelectorAll('.item-row').length;
                const codigoFormateado = generarCodigoItem(currentIndex + 1);
                const esOtraMoneda = document.getElementById('otraMonedaCambio') !== null;

                const camposOtraMonedaItem = esOtraMoneda ? `
                    <input type="hidden" name="ECF.DetallesItems.Item[${currentIndex}].OtraMonedaDetalle.PrecioOtraMoneda" class="item-precio-otra" value="0.00" />
                    <input type="hidden" name="ECF.DetallesItems.Item[${currentIndex}].OtraMonedaDetalle.MontoItemOtraMoneda" class="item-monto-otra" value="0.00" />
                ` : '';

                const newRowHtml = `
                    <div class="item-row card mb-3">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5>Item ${currentIndex + 1}</h5>
                            <button type="button" class="btn btn-danger btn-sm remove-item">Eliminar</button>
                        </div>
                        <div class="card-body row">
                            <input type="hidden" name="ECF.DetallesItems.Item[${currentIndex}].NumeroLinea" value="${currentIndex + 1}" class="item-numero-linea" />
                            ${camposOtraMonedaItem}

                            <div class="form-group col-md-3">
                                <label>Código del Ítem</label>
                                <input name="ECF.DetallesItems.Item[${currentIndex}].TablaCodigosItem.CodigosItem[0].CodigoItem" class="form-control item-codigo" value="${codigoFormateado}" readonly />
                            </div>
                            <div class="form-group col-md-3">
                                <label>Nombre del Item</label>
                                <input name="ECF.DetallesItems.Item[${currentIndex}].NombreItem" class="form-control item-name" value="" required />
                            </div>
                            <div class="form-group col-md-2">
                                <label>Tipo</label>
                                <select name="ECF.DetallesItems.Item[${currentIndex}].IndicadorBienoServicio" class="form-control">
                                    <option value="1">Bien</option>
                                    <option value="2">Servicio</option>
                                </select>
                            </div>
                            <div class="form-group col-md-1 border border-danger p-2 rounded bg-light">
                                <label class="text-danger fw-bold">Ind. Fact.</label>
                                <input name="ECF.DetallesItems.Item[${currentIndex}].IndicadorFacturacion" class="form-control border-danger" value="1" readonly />
                            </div>
                            <div class="form-group col-md-2">
                                <label>Cantidad</label>
                                <input name="ECF.DetallesItems.Item[${currentIndex}].CantidadItem" type="number" step="0.01" min="0.01" class="form-control item-quantity" value="1.00" required />
                            </div>
                            <div class="form-group col-md-2">
                                <label>Unidad</label>
                                <input name="ECF.DetallesItems.Item[${currentIndex}].UnidadMedida" type="number" step="0.01" class="form-control" value="43" readonly />
                            </div>
                            <div class="form-group col-md-2">
                                <label>Precio Unitario</label>
                                <input name="ECF.DetallesItems.Item[${currentIndex}].PrecioUnitarioItem" type="number" step="0.01" min="0.01" class="form-control item-price" value="0.00" required />
                            </div>
                            <div class="form-group col-md-2">
                                <label>Total</label>
                                <input name="ECF.DetallesItems.Item[${currentIndex}].MontoItem" type="number" step="0.01" class="form-control item-total" value="0.00" readonly />
                            </div>
                        </div>
                    </div>
                `;

                container.insertAdjacentHTML('beforeend', newRowHtml);
                calcularTotalesE31();
            });

            // Eliminar Ítem y reindexar
            container.addEventListener('click', function (e) {
                if (e.target && e.target.classList.contains('remove-item')) {
                    const rows = container.querySelectorAll('.item-row');
                    if (rows.length > 1) {
                        e.target.closest('.item-row').remove();
                        reindexItems();
                        calcularTotalesE31();
                    } else {
                        alert('Debe conservar al menos un ítem en la factura.');
                    }
                }
            });

            function reindexItems() {
                const rows = container.querySelectorAll('.item-row');
                rows.forEach((row, index) => {
                    row.querySelector('h5').textContent = `Item ${index + 1}`;

                    const codigoInput = row.querySelector('.item-codigo');
                    if (codigoInput) {
                        codigoInput.value = generarCodigoItem(index + 1);
                    }

                    const hiddenLinea = row.querySelector('.item-numero-linea');
                    if (hiddenLinea) {
                        hiddenLinea.value = index + 1;
                        hiddenLinea.setAttribute('name', `ECF.DetallesItems.Item[${index}].NumeroLinea`);
                    }

                    const inputs = row.querySelectorAll('input, select');
                    inputs.forEach(input => {
                        const currentName = input.getAttribute('name');
                        if (currentName) {
                            const newName = currentName.replace(/ECF\.DetallesItems\.Item\[\d+\]/, `ECF.DetallesItems.Item[${index}]`);
                            input.setAttribute('name', newName);
                        }
                    });
                });
            }

            if (container) {
                container.addEventListener('input', function (e) {
                    if (e.target.classList.contains('item-quantity') || e.target.classList.contains('item-price')) {
                        calcularTotalesE31();
                    }
                });
            }

            if (form) {
                form.addEventListener('submit', function () {
                    calcularTotalesE31();

                    const tasaCambio = obtenerTasaCambio();
                    if (tasaCambio !== 1) {
                        document.querySelectorAll('.item-row').forEach(fila => {
                            const cantInput = fila.querySelector('.item-quantity');
                            const precioInput = fila.querySelector('.item-price');
                            const totalInput = fila.querySelector('.item-total');

                            const cantidad = parseFloat(cantInput.value) || 0;
                            const precioDOP = (parseFloat(precioInput.value) || 0) * tasaCambio;
                            const montoDOP = cantidad * precioDOP;

                            precioInput.value = precioDOP.toFixed(2);
                            totalInput.value = montoDOP.toFixed(2);
                        });
                    }
                });
            }
        });
    </script>
}