@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const container = document.getElementById('itemsContainer');
            const addBtn = document.getElementById('addItemBtn');

            // 1. Agregar nuevo Ítem
            addBtn.addEventListener('click', function () {
                // Obtener el número actual de filas para definir el nuevo índice
                const currentIndex = container.querySelectorAll('.item-row').length;

                const newRowHtml = `
                    <div class="item-row card mb-3">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5>Item ${currentIndex + 1}</h5>
                            <button type="button" class="btn btn-danger btn-sm remove-item">Eliminar</button>
                        </div>
                        <div class="card-body row">
                            <input type="hidden" name="ECF.DetallesItems.Item[${currentIndex}].NumeroLinea" value="${currentIndex + 1}" class="item-numero-linea" />

                            <div class="form-group col-md-3">
                                <label>Código del Ítem</label>
                                <input name="ECF.DetallesItems.Item[${currentIndex}].TablaCodigosItem.CodigosItem[0].CodigoItem" class="form-control" value="" />
                            </div>
                            <div class="form-group col-md-3">
                                <label>Nombre del Item</label>
                                <input name="ECF.DetallesItems.Item[${currentIndex}].NombreItem" class="form-control item-name" value="" />
                            </div>
                            <div class="form-group col-md-2">
                                <label>Tipo</label>
                                <select name="ECF.DetallesItems.Item[${currentIndex}].IndicadorBienoServicio" class="form-control">
                                    <option value="1">Bien</option>
                                    <option value="2">Servicio</option>
                                </select>
                            </div>
                            <div class="form-group col-md-1 border border-danger p-2 rounded bg-light">
                                <label class="text-danger fw-bold">Ind. Fact.</label>
                                <input name="ECF.DetallesItems.Item[${currentIndex}].IndicadorFacturacion" class="form-control border-danger" value="1" readonly />
                            </div>
                            <div class="form-group col-md-2">
                                <label>Cantidad</label>
                                <input name="ECF.DetallesItems.Item[${currentIndex}].CantidadItem" type="number" step="0.01" class="form-control item-quantity" value="1.00" />
                            </div>
                            <div class="form-group col-md-2">
                                <label>Unidad</label>
                                <input name="ECF.DetallesItems.Item[${currentIndex}].UnidadMedida" type="number" step="0.01" class="form-control" value="1" />
                            </div>
                            <div class="form-group col-md-2">
                                <label>Precio Unitario</label>
                                <input name="ECF.DetallesItems.Item[${currentIndex}].PrecioUnitarioItem" type="number" step="0.01" class="form-control item-price" value="0.00" />
                            </div>
                            <div class="form-group col-md-2">
                                <label>Total</label>
                                <input name="ECF.DetallesItems.Item[${currentIndex}].MontoItem" type="number" step="0.01" class="form-control item-total" value="0.00" readonly />
                            </div>
                        </div>
                    </div>
                `;

                container.insertAdjacentHTML('beforeend', newRowHtml);
            });

            // 2. Eliminar Ítem y reindexar campos
            container.addEventListener('click', function (e) {
                if (e.target && e.target.classList.contains('remove-item')) {
                    const rows = container.querySelectorAll('.item-row');
                    // Evitar que eliminen si solo queda 1 fila
                    if (rows.length > 1) {
                        e.target.closest('.item-row').remove();
                        reindexItems();
                    } else {
                        alert('Debe conservar al menos un ítem en la factura.');
                    }
                }
            });

            // Función para reajustar los índices [0], [1], [2] tras eliminar un elemento intermedio
            function reindexItems() {
                const rows = container.querySelectorAll('.item-row');
                rows.forEach((row, index) => {
                    // Actualizar el título del Card
                    row.querySelector('h5').textContent = `Item ${index + 1}`;

                    // Actualizar el valor y name de NumeroLinea
                    const hiddenLinea = row.querySelector('.item-numero-linea');
                    if (hiddenLinea) {
                        hiddenLinea.value = index + 1;
                        hiddenLinea.setAttribute('name', `ECF.DetallesItems.Item[${index}].NumeroLinea`);
                    }

                    // Actualizar atributicos `name` de los demas campos de la fila
                    const inputs = row.querySelectorAll('input, select');
                    inputs.forEach(input => {
                        const currentName = input.getAttribute('name');
                        if (currentName) {
                            const newName = currentName.replace(/ECF\.DetallesItems\.Item\[\d+\]/, `ECF.DetallesItems.Item[${index}]`);
                            input.setAttribute('name', newName);
                        }
                    });
                });
            }
        });


        // 1. Declaración de la función de cálculo
        function calcularTotalesE31() {
            let montoGravado = 0;
            const tasaITBIS18 = 0.18;

            const filas = document.querySelectorAll('.item-row');
            filas.forEach(fila => {
                const cantInput = fila.querySelector('.item-quantity');
                const precioInput = fila.querySelector('.item-price');
                const totalInput = fila.querySelector('.item-total');

                const cantidad = parseFloat(cantInput ? cantInput.value : 0) || 0;
                const precio = parseFloat(precioInput ? precioInput.value : 0) || 0;

                const montoLinea = cantidad * precio;
                if (totalInput) {
                    totalInput.value = montoLinea.toFixed(2);
                }

                montoGravado += montoLinea;
            });

            const totalITBIS18 = montoGravado * tasaITBIS18;
            const montoTotalFactura = montoGravado + totalITBIS18;

            document.getElementById('montoGravadoTotal').value = montoGravado.toFixed(2);
            document.getElementById('montoGravadoI1').value = montoGravado.toFixed(2);
            document.getElementById('ITBIS1').value = "18";
            document.getElementById('totalITBIS').value = totalITBIS18.toFixed(2);
            document.getElementById('totalITBIS1').value = totalITBIS18.toFixed(2);
            document.getElementById('totalGeneral').value = montoTotalFactura.toFixed(2);
            document.getElementById('MontoPeriodo').value = montoTotalFactura.toFixed(2);
            document.getElementById('ValorPagar').value = montoTotalFactura.toFixed(2);
        }

        // 2. Eventos al cargar la página
        document.addEventListener('DOMContentLoaded', function () {
            const container = document.getElementById('itemsContainer');
            const form = document.querySelector('form');

            // --- AQUÍ VA LA OPCIÓN 2 ---
            // Escucha cuando el usuario cambia o sale de las casillas de cantidad o precio
            if (container) {
                container.addEventListener('change', function (e) {
                    if (e.target.classList.contains('item-quantity') || e.target.classList.contains('item-price')) {
                        calcularTotalesE31();
                    }
                });
            }

            // --- OPCIÓN 3 DE SEGURIDAD ---
            // Forzar recálculo automático al hacer clic en el botón de guardar/enviar la factura
            if (form) {
                form.addEventListener('submit', function () {
                    calcularTotalesE31();
                });
            }
        });
    </script>
}