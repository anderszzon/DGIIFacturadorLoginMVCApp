}

<h2>Registrar Comprobante</h2>

<form id="comprobanteForm" method="get">
    <label for="comprobante">Seleccione un comprobante:</label>
    <select id="comprobante" name="comprobante">

        <option value="">Seleccione</option>

        <option value="E32">E320000000006</option>
        <option value="E31A">E310000000001 OK</option>
        <option value="E41"> E410000000001 OK</option>
        <option value="E31B">E310000000011 OK</option>
        <option value="E43"> E430000000001 OK</option>
        <option value="E46"> E460000000001 OK</option>

        <option value="E31C">E31C</option>
        <option value="E31D">E31D</option>
        <option value="E31E">E31E</option>
        <option value="E32A">E32A</option>
        <option value="E32B">E32B</option>

        <option value="E33">E33</option>
        <option value="E34">E34</option>
        <option value="E44">E44</option>
        <option value="E45">E45</option>
        <option value="E47">E47</option>

        <option value="E33">E33</option>
        <option value="E34">E34</option>
        <option value="E44">E44</option>
        <option value="E45">E45</option>
        <option value="E47">E47</option>

        <option value="E33">E33</option>
        <option value="E34">E34</option>
        <option value="E44">E44</option>
        <option value="E45">E45</option>
        <option value="E47">E47</option>

    </select>

    <button type="button" onclick="redirigir()">Ir a Comprobante</button>
</form>

<script>
    function redirigir() {
        const comprobante = document.getElementById("comprobante").value;
        if (comprobante) {
            window.location.href = "/FacturacionDGII/comprobante" + comprobante;
        } else {
            alert("Seleccione un comprobante.");
        }
    }
</script>
