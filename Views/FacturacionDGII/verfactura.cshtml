@model FacturaDGIIResponseModel

@if (Model?.CodigoRespuesta == "1")
{
    <div class="container mt-4">
        <div class="alert alert-success d-flex justify-content-between align-items-center" role="alert">
            <div>
                <strong>¡Procesado con éxito!</strong> El comprobante <strong>@Model.ENCF</strong> fue aceptado por la DGII.
            </div>
            <div>
                <a class="btn btn-success btn-sm" href="@Url.Action("GenerarPDF", "FacturacionDGII", new { id = Model.FacturaId, codigoSeguridad = Model.CodigoSeguridad })" target="_blank">
                    Ver PDF
                </a>
                <a class="btn btn-outline-success btn-sm bg-white" href="@Url.Action("GenerarXMLDownloads", "FacturacionDGII", new { id = Model.FacturaId })" target="_blank">
                    Descargar XML Firmado
                </a>
            </div>
        </div>

        <!-- Resumen Principal (Sin desbordamiento) -->
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Detalles del Comprobante DGII</h4>
            </div>
            <div class="card-body">
                <table class="table table-bordered table-hover" style="table-layout: fixed;">
                    <tbody>
                        <tr>
                            <th scope="row" style="width: 25%;">e-NCF</th>
                            <td><strong>@Model.ENCF</strong></td>
                        </tr>
                        <tr>
                            <th scope="row">Estado Respuesta</th>
                            <td><span class="badge bg-success text-white">@Model.EstadoRespuesta</span> (Código: @Model.CodigoRespuesta)</td>
                        </tr>
                        <tr>
                            <th scope="row">Código de Seguridad</th>
                            <td><code>@Model.CodigoSeguridad</code></td>
                        </tr>
                        <tr>
                            <th scope="row">Mensaje DGII</th>
                            <td>@Model.Mensaje</td>
                        </tr>
                    </tbody>
                </table>


                <!-- Sección Agrupada: Trazabilidad Técnica en Popup -->
                <div class="mt-4 pt-3 border-top">
                    <h6 class="text-muted mb-3">Trazabilidad Técnica (XML / JSON / Tokens)</h6>
                    <div class="d-flex flex-wrap">
                        @if (!string.IsNullOrWhiteSpace(Model.XmlSemilla))
                        {
                            <button type="button" class="btn btn-outline-dark btn-sm mr-2 mb-2 btn-ver-detalle"
                                    data-titulo="XML Semilla"
                                    data-target="raw-xml-semilla">
                                Ver XML Semilla
                            </button>
                            <textarea id="raw-xml-semilla" class="d-none">@Model.XmlSemilla</textarea>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.XmlSemillaFirmada))
                        {
                            <button type="button" class="btn btn-outline-dark btn-sm mr-2 mb-2 btn-ver-detalle"
                                    data-titulo="XML Semilla Firmada"
                                    data-target="raw-semilla-firmada">
                                Ver XML Semilla Firmada
                            </button>
                            <textarea id="raw-semilla-firmada" class="d-none">@Model.XmlSemillaFirmada</textarea>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.JsonInvoice))
                        {
                            <button type="button" class="btn btn-outline-info btn-sm mr-2 mb-2 btn-ver-detalle"
                                    data-titulo="JSON Invoice (@Model.ENCF)"
                                    data-target="raw-json-invoice">
                                Ver JSON Invoice
                            </button>
                            <textarea id="raw-json-invoice" class="d-none">@Model.JsonInvoice</textarea>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Token))
                        {
                            <button type="button" class="btn btn-outline-warning btn-sm mr-2 mb-2 btn-ver-detalle"
                                    data-titulo="Token de Autenticación DGII"
                                    data-target="raw-token">
                                Ver Token
                            </button>
                            <textarea id="raw-token" class="d-none">@Model.Token</textarea>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.XmlFactura))
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm mr-2 mb-2 btn-ver-detalle"
                                    data-titulo="XML Factura (@Model.ENCF)"
                                    data-target="raw-xml-factura">
                                Ver XML Factura
                            </button>
                            <textarea id="raw-xml-factura" class="d-none">@Model.XmlFactura</textarea>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.XmlFacturaFirmada))
                        {
                            <button type="button" class="btn btn-outline-primary btn-sm mr-2 mb-2 btn-ver-detalle"
                                    data-titulo="XML Factura Firmada (@Model.ENCF)"
                                    data-target="raw-xml-firmado">
                                Ver XML Factura Firmada
                            </button>
                            <textarea id="raw-xml-firmado" class="d-none">@Model.XmlFacturaFirmada</textarea>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Popup para visualizar XML / JSON sin romper la pantalla -->
    <div class="modal fade" id="detalleTecnicoModal" tabindex="-1" role="dialog" aria-labelledby="detalleTecnicoModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title" id="detalleTecnicoModalLabel">Detalle Técnico</h5>
                    <button type="button" class="close text-white btn-cerrar-modal" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Cerrar">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body bg-light">
                    <pre id="detalleTecnicoContenido" class="p-3 bg-white border rounded" style="max-height: 60vh; overflow-y: auto; white-space: pre-wrap; word-break: break-all; font-size: 0.82rem;"></pre>
                </div>
                <div class="modal-footer">
                    <button type="button" id="btnCopiarDetalle" class="btn btn-primary btn-sm">Copiar contenido</button>
                    <button type="button" class="btn btn-secondary btn-sm btn-cerrar-modal" data-dismiss="modal" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}
else if (!string.IsNullOrEmpty(Model?.Mensaje))
{
    <div class="container mt-4">
        <div class="alert alert-danger" role="alert">
            <strong>Error:</strong> @Model?.Mensaje
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const modalEl = document.getElementById('detalleTecnicoModal');
            const tituloEl = document.getElementById('detalleTecnicoModalLabel');
            const contenidoEl = document.getElementById('detalleTecnicoContenido');
            const btnCopiar = document.getElementById('btnCopiarDetalle');

            // Compatible con Bootstrap 4 (jQuery) y Bootstrap 5 (Vanilla)
            function abrirModal() {
                if (window.bootstrap && bootstrap.Modal) {
                    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                    modal.show();
                } else if (window.jQuery) {
                    $('#detalleTecnicoModal').modal('show');
                }
            }

            document.querySelectorAll('.btn-ver-detalle').forEach(btn => {
                btn.addEventListener('click', function () {
                    const titulo = this.getAttribute('data-titulo');
                    const targetId = this.getAttribute('data-target');
                    const rawTextarea = document.getElementById(targetId);

                    tituloEl.textContent = titulo;
                    contenidoEl.textContent = rawTextarea ? rawTextarea.value : '';
                    btnCopiar.textContent = 'Copiar contenido';
                    abrirModal();
                });
            });

            if (btnCopiar) {
                btnCopiar.addEventListener('click', async function () {
                    try {
                        await navigator.clipboard.writeText(contenidoEl.textContent);
                        btnCopiar.textContent = '¡Copiado!';
                        setTimeout(() => btnCopiar.textContent = 'Copiar contenido', 2000);
                    } catch (e) {
                        alert('No se pudo copiar automáticamente.');
                    }
                });
            }
        });
    </script>
}